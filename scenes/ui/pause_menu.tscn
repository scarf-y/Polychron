[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1_script"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 110
script = ExtResource("1_script")

[node name="Dimmer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="CenterContainer" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuVBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="CenterContainer/MenuVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0.8, 1, 1)
theme_override_font_sizes/font_size = 32
text = "PAUSED"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="CenterContainer/MenuVBox"]
custom_minimum_size = Vector2(200, 40)
layout_mode = 2
text = "RESUME"

[node name="MenuButton" type="Button" parent="CenterContainer/MenuVBox"]
custom_minimum_size = Vector2(200, 40)
layout_mode = 2
text = "QUIT TO MENU"

[node name="ConfirmPanel" type="PanelContainer" parent="CenterContainer"]
visible = false
custom_minimum_size = Vector2(300, 150)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="CenterContainer/ConfirmPanel"]
layout_mode = 2
theme_override_constants/separation = 15
alignment = 1

[node name="Warning" type="Label" parent="CenterContainer/ConfirmPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
theme_override_font_sizes/font_size = 14
text = "ABANDON SEQUENCE?
(Current run progress will be lost)"
horizontal_alignment = 1

[node name="HBox" type="HBoxContainer" parent="CenterContainer/ConfirmPanel/VBox"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="ConfirmQuit" type="Button" parent="CenterContainer/ConfirmPanel/VBox/HBox"]
custom_minimum_size = Vector2(100, 35)
layout_mode = 2
text = "YES"

[node name="CancelQuit" type="Button" parent="CenterContainer/ConfirmPanel/VBox/HBox"]
custom_minimum_size = Vector2(100, 35)
layout_mode = 2
text = "NO"

[connection signal="pressed" from="CenterContainer/MenuVBox/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="CenterContainer/MenuVBox/MenuButton" to="." method="_on_menu_pressed"]
[connection signal="pressed" from="CenterContainer/ConfirmPanel/VBox/HBox/ConfirmQuit" to="." method="_on_confirm_quit_pressed"]
[connection signal="pressed" from="CenterContainer/ConfirmPanel/VBox/HBox/CancelQuit" to="." method="_on_cancel_quit_pressed"]
